# 部署者无需改 Dockerfile，改这里即可。
# 复制为 .env 后按需修改：cp .env.example .env

# Docker Hub 上的官方 v2fly 镜像 tag，同时作为 v2ray-core 的版本。
# 4.x 与 5.x 的 CLI 不同，脚本会自动探测；可用 V2RAY_CLI 强制指定。
# 可选值示例：v5.41.0（本方案默认）、v4.45.2
V2RAY_VERSION=v5.41.0

# 对外暴露的 WebSocket 明文端口。TLS 由 CDN 或外层反向代理终止。
V2RAY_PORT=10000

# WebSocket 路径。建议换成不易猜测的值，降低被主动探测识别的概率。
V2RAY_WS_PATH=/vless-ws

# 服务端 UUID（客户端从此派生，必须一致）。
# 留空则首次启动自动生成并写入挂载的 ./data/uuid，重启后保持不变。
# 自行生成：python -c "import uuid;print(uuid.uuid4)"
# 注意：不要用 v2ray 自身的 v2ctl uuid（v5 已移除该子命令）。
V2RAY_UUID=

# 可选：限定 WebSocket 的 Host 头（CDN 回源时用于校验）。留空表示不校验。
V2RAY_WS_HOST=

# 客户端实际连接的域名（走 CDN 就填 CDN 域名），用于生成分享链接。
# 留空则回退到 V2RAY_WS_HOST；两者都空时链接里的域名是占位符 your.domain.com。
V2RAY_SHARE_HOST=
# 分享链接里的端口，TLS 由 CDN/反代终止，通常填 443。
V2RAY_SHARE_PORT=443

# 日志级别：debug / info / warning / error / none
V2RAY_LOG_LEVEL=warning
# 留空则访问日志输出到容器 stdout、错误日志输出到 stderr（便于 docker logs）。
V2RAY_LOG_ACCESS=
V2RAY_LOG_ERROR=

# 是否开启流量嗅探（用于按域名分流）。
V2RAY_SNIFFING=true
# 出站域名解析策略：AsIs / UseIP / UseIPv4 / UseIPv6
V2RAY_DOMAIN_STRATEGY=UseIP

# 是否丢弃目标是私网地址的出站流量（防止服务端被当作访问内网的跳板）。
V2RAY_BLOCK_PRIVATE=true

# 监听地址与端口映射。本机直连测试可改为 127.0.0.1。
LISTEN_ADDR=0.0.0.0
